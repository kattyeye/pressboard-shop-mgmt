# Supabase project (Project Settings > API). The publishable key is safe in the browser;
# row level security in the database decides what each person can see.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, demo only: shows one-click demo sign-in buttons on /login.
# Leave unset in a real shop's deployment.
NEXT_PUBLIC_DEMO_PASSWORD=
